{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "TZ"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DIRECT_URL", "DATABASE_URL", "NEXT_PUBLIC_APP_URL", "API_INTERNAL_URL"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "JWT_ACCESS_TTL",
        "JWT_REFRESH_TTL",
        "ENCRYPTION_KEY",
        "ENCRYPTION_KEY_VERSION",
        "HMAC_DOC_KEY",
        "COOKIE_DOMAIN",
        "CORS_ORIGIN",
        "API_PORT"
      ]
    }
  }
}
