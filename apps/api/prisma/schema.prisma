// Esquema núcleo — Etapa 1.
// Diseño aprobado en docs/ETAPA-01.md §1. Los cambios de esquema a mitad de camino
// son el mayor costo de este proyecto: cualquier modificación se propone primero.
//
// Toda tabla que se agregue con `empresaId` debe traer su política de Row Level
// Security en la misma migración (docs/SEGURIDAD.md §1).

generator client {
  provider = "prisma-client-js"
}

// Desde Prisma 7 las URLs de conexión no van en el esquema:
//   - las migraciones toman DIRECT_URL (rol nexo_owner) desde prisma.config.ts
//   - el runtime toma DATABASE_URL (rol nexo_app) desde el driver adapter en
//     PrismaService, que es lo que hace que la RLS aplique de verdad
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum ModuloSistema {
  OPERACIONES
  EGRESOS
  EMPLEADOS
  CONTABILIDAD
  CUMPLIMIENTO
  CLIENTES
  ADMINISTRACION
}

enum NombreRol {
  ADMINISTRADOR
  EQUIPO_INTERNO
}

enum TipoContribuyente {
  GRAN_CONTRIBUYENTE
  PERSONA_JURIDICA
  PERSONA_NATURAL
  REGIMEN_SIMPLE
  NO_RESPONSABLE_IVA
}

enum TipoDocumento {
  CC
  CE
  NIT
  PASAPORTE
  PPT
}

enum Moneda {
  COP
  USD
  USDT
}

enum TipoConsecutivo {
  ORDEN_PAGO
  FACTURA
  RECIBO_NOMINA
}

enum AccionAudit {
  CREAR
  ACTUALIZAR
  ANULAR
  ELIMINAR // soft delete: nada se borra físicamente
  INGRESAR
  SALIR
  INGRESO_FALLIDO
  EXPORTAR // exportación masiva de datos personales — Ley 1581
  CAMBIAR_EMPRESA
  LLAMADA_EXTERNA
}

// ─────────────────────────────────────────────────────────────
// Empresa administrada — raíz de todo el aislamiento
// ─────────────────────────────────────────────────────────────

model EmpresaAdministrada {
  id                  String            @id @default(cuid())
  nombre              String
  nombreComercial     String?
  nit                 String            @unique
  digitoVerificacion  Int
  tipoContribuyente   TipoContribuyente
  municipio           String // sede principal — define el ICA
  codigoDaneMunicipio String?
  direccion           String?
  telefono            String?
  email               String?
  logoUrl             String? // identidad de la empresa en los PDF generados
  esNexo              Boolean           @default(false) // índice único parcial: solo una
  activa              Boolean           @default(true)

  usuarios     UsuarioEmpresa[]
  consecutivos Consecutivo[]
  auditLogs    AuditLog[]

  clientes           Cliente[]
  operaciones        Operacion[]
  destinatarios      Destinatario[]
  reglasDispersion   ReglaDispersion[]
  reglasDestino      ReglaDispersionDestino[]
  dispersiones       Dispersion[]
  dispersionDestinos DispersionDestino[]

  // Etapa 3
  egresos     Egreso[]
  ordenesPago OrdenPago[]

  // Etapa 5
  empleados           Empleado[]
  recibosNomina       ReciboNomina[]
  conceptosNomina     ConceptoNomina[]
  documentosLaborales DocumentoLaboral[]

  // Etapa 6a
  gastos               Gasto[]
  solicitudesDocumento SolicitudDocumento[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([activa, deletedAt])
}

// ─────────────────────────────────────────────────────────────
// Identidad y acceso
// ─────────────────────────────────────────────────────────────

model Rol {
  id          String    @id @default(cuid())
  nombre      NombreRol @unique
  descripcion String?
  usuarios    Usuario[]
}

model Usuario {
  id           String @id @default(cuid())
  nombre       String
  email        String @unique
  passwordHash String // argon2id

  totpSecretCifrado String? // AES-256-GCM; null hasta que registre el 2FA
  totpActivado      Boolean @default(false)

  // Un código TOTP sirve una sola vez: dentro de su ventana de validez no se
  // vuelve a aceptar. Sin esto, un código interceptado se puede reusar durante
  // los segundos que le queden de vida (docs/SEGURIDAD.md §4).
  ultimoTotpUsado String?
  ultimoTotpEn    DateTime?

  rolId  String
  rol    Rol     @relation(fields: [rolId], references: [id])
  activo Boolean @default(true)

  debeCambiarPassword Boolean   @default(true)
  ultimoAcceso        DateTime?
  intentosFallidos    Int       @default(0)
  bloqueadoHasta      DateTime?

  empresas                UsuarioEmpresa[]
  permisos                PermisoModulo[]
  operacionesAnuladas     Operacion[]             @relation("operacionAnuladaPor")
  egresosAnulados         Egreso[]                @relation("egresoAnuladoPor")
  ordenesEmitidas         OrdenPago[]             @relation("ordenEmitidaPor")
  ordenesAnuladas         OrdenPago[]             @relation("ordenAnuladaPor")
  recibosEmitidos         ReciboNomina[]          @relation("reciboEmitidoPor")
  recibosAnulados         ReciboNomina[]          @relation("reciboAnuladoPor")
  documentosEmitidos      DocumentoLaboral[]      @relation("documentoEmitidoPor")
  importacionesCalendario ImportacionCalendario[] @relation("calendarioImportadoPor")
  sesiones                SesionRefresh[]
  codigosRespaldo         CodigoRespaldo[]
  auditLogs               AuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email, deletedAt])
}

/// Qué empresas puede ver un usuario. El rol ADMINISTRADOR accede a todas sin
/// necesidad de filas aquí; se resuelve en EmpresaGuard.
model UsuarioEmpresa {
  id        String @id @default(cuid())
  usuarioId String
  empresaId String

  usuario Usuario             @relation(fields: [usuarioId], references: [id])
  empresa EmpresaAdministrada @relation(fields: [empresaId], references: [id])

  createdAt DateTime @default(now())

  @@unique([usuarioId, empresaId])
  @@index([empresaId])
}

/// Permiso por módulo, global al usuario y no por empresa (decisión confirmada,
/// docs/ARQUITECTURA.md §5.2). Se verifica SIEMPRE en el backend.
model PermisoModulo {
  id          String        @id @default(cuid())
  usuarioId   String
  modulo      ModuloSistema
  puedeVer    Boolean       @default(false)
  puedeEditar Boolean       @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, modulo])
}

/// Refresh tokens con rotación. Reusar un token ya consumido revoca toda la familia.
model SesionRefresh {
  id        String @id @default(cuid())
  usuarioId String
  tokenHash String @unique // SHA-256 del token; el token en claro no se guarda
  familiaId String

  expiraEn   DateTime
  revocadaEn DateTime?
  ip         String?
  userAgent  String?

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())

  @@index([usuarioId, revocadaEn])
  @@index([familiaId])
}

/// Códigos de un solo uso para recuperar el acceso si se pierde el TOTP.
model CodigoRespaldo {
  id         String    @id @default(cuid())
  usuarioId  String
  codigoHash String
  usadoEn    DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())

  @@index([usuarioId, usadoEn])
}

// ─────────────────────────────────────────────────────────────
// Consecutivos de documentos legales
// ─────────────────────────────────────────────────────────────

/// Se incrementa con bloqueo de fila dentro de la misma transacción que crea el
/// documento. Nunca se calcula con count(). Un consecutivo emitido no se reutiliza
/// aunque el documento se anule.
model Consecutivo {
  id          String          @id @default(cuid())
  empresaId   String
  tipo        TipoConsecutivo
  prefijo     String          @default("")
  ultimoValor Int             @default(0)

  empresa EmpresaAdministrada @relation(fields: [empresaId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([empresaId, tipo])
}

// ─────────────────────────────────────────────────────────────
// Audit log — append-only, garantizado por trigger y permisos
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id        BigInt      @id @default(autoincrement())
  usuarioId String?
  empresaId String? // null en eventos previos a elegir empresa (ingreso, fallo)
  accion    AccionAudit
  entidad   String
  entidadId String?

  valorAnterior Json?
  valorNuevo    Json?

  ip        String?
  userAgent String?
  ruta      String?
  createdAt DateTime @default(now())

  usuario Usuario?             @relation(fields: [usuarioId], references: [id])
  empresa EmpresaAdministrada? @relation(fields: [empresaId], references: [id])

  @@index([empresaId, createdAt])
  @@index([usuarioId, createdAt])
  @@index([entidad, entidadId])
  @@index([createdAt])
}

// ═════════════════════════════════════════════════════════════
// Etapa 2 — Operaciones y dispersión
// ═════════════════════════════════════════════════════════════

enum TipoCliente {
  PERSONA_NATURAL
  PERSONA_JURIDICA
}

enum EstadoOperacion {
  BORRADOR // se está capturando; no cuenta para reportes
  REGISTRADA // completa y vigente; editable
  CONCILIADA // su dispersión quedó ejecutada por completo; ya no se edita
  ANULADA // sin efecto, se conserva con su motivo
}

enum RedBlockchain {
  BITCOIN
  ETHEREUM
  TRON
  BSC
  POLYGON
  SOLANA
  OTRA
}

enum TipoReparto {
  PORCENTAJE
  MONTO_FIJO
}

enum EstadoDispersion {
  PENDIENTE
  PARCIAL
  EJECUTADA
}

enum EstadoDestino {
  PENDIENTE
  EJECUTADO
  DEVUELTO
}

/// Adelanto mínimo de la Etapa 4: `Operacion` cuelga de un cliente. La Etapa 4 le
/// agrega portafolio, contacto y calendario tributario.
model Cliente {
  id        String @id @default(cuid())
  empresaId String

  nombre  String
  tipo    TipoCliente
  tipoDoc TipoDocumento

  /// Cifrado con AES-256-GCM: es un dato personal (Ley 1581, docs/SEGURIDAD.md §5).
  numeroDocCifrado String
  /// HMAC determinista. Es lo único indexable: permite buscar por documento sin
  /// descifrar y sin exponer el número en claro dentro de un índice.
  numeroDocHash    String
  /// Últimos cuatro dígitos, para mostrar «•••• 4821» sin descifrar en cada fila.
  numeroDocFinal   String

  // ── Lo que el calendario tributario necesita (etapa 6) ────────────────────
  // Son tres datos: el último dígito del NIT, el tipo de contribuyente y —solo
  // para ICA— el municipio. Se piden desde ya, con la tabla casi vacía: pedirlos
  // en la etapa 6 obligaría a completarlos a mano, cliente por cliente.
  /// Define las fechas del calendario tributario.
  ultimoDigitoNit     Int?
  tipoContribuyente   TipoContribuyente?
  municipio           String?
  /// El ICA es municipal. El código DANE identifica el municipio sin ambigüedad;
  /// «Medellín» escrito a mano no cruza con ninguna tabla.
  codigoDaneMunicipio String?

  direccion      String?
  nombreContacto String?
  email          String?
  telefono       String?

  /// Activo o retirado del portafolio.
  ///
  /// Distinto de `deletedAt`, y a propósito: un cliente retirado no debe aparecer
  /// al registrar una operación nueva, pero su historial tiene que seguir
  /// consultable. Un soft delete lo escondería de las dos cosas.
  activo Boolean @default(true)

  empresa     EmpresaAdministrada  @relation(fields: [empresaId], references: [id])
  operaciones Operacion[]
  solicitudes SolicitudDocumento[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([empresaId, numeroDocHash])
  @@index([empresaId, nombre])
}

model Operacion {
  id        String @id @default(cuid())
  empresaId String
  clienteId String

  /// Hash de la transacción en la cadena. Es el buscador central del sistema.
  hash String?
  red  RedBlockchain?

  // ── El activo que se movió ────────────────────────────────────────────────
  // TODO [CONFIRMAR] Opcionales hasta que el cliente confirme si registra la
  // cantidad de cripto o solo los valores en pesos. Nulos, la ganancia es la
  // resta directa entre venta y compra.
  cantidad     Decimal? @db.Decimal(36, 18)
  monedaActivo Moneda?

  // ── La plata que entró y salió ────────────────────────────────────────────
  // Dos tasas y no una: la de compra y la de venta son distintas, y en esa
  // diferencia está el negocio. Quedan congeladas al momento de la operación —
  // recalcular con la tasa de hoy cambiaría el resultado de un cierre pasado.
  valorCompra  Decimal  @db.Decimal(18, 2)
  monedaCompra Moneda
  tasaCompra   Decimal? @db.Decimal(18, 6)

  valorVenta  Decimal  @db.Decimal(18, 2)
  monedaVenta Moneda
  tasaVenta   Decimal? @db.Decimal(18, 6)

  /// Calculada y persistida al guardar, nunca derivada en cada lectura (brief §5).
  gananciaCOP Decimal @db.Decimal(18, 2)

  estado         EstadoOperacion @default(REGISTRADA)
  fechaOperacion DateTime
  observaciones  String?

  motivoAnulacion String?
  anuladaEn       DateTime?
  anuladaPorId    String?

  empresa    EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  cliente    Cliente             @relation(fields: [clienteId], references: [id])
  anuladaPor Usuario?            @relation("operacionAnuladaPor", fields: [anuladaPorId], references: [id])
  dispersion Dispersion?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// El buscador por hash es la función más usada del sistema: este índice es lo
  /// que hace que responda al instante en vez de recorrer la tabla.
  @@unique([empresaId, hash])
  @@index([empresaId, fechaOperacion(sort: Desc)])
  @@index([empresaId, estado])
  @@index([clienteId])
}

/// Catálogo de a quién se le dispersa. Existe para no volver a escribir la cuenta
/// bancaria en cada operación, que es donde se cometen los errores caros.
model Destinatario {
  id        String @id @default(cuid())
  empresaId String

  nombre  String
  tipoDoc TipoDocumento

  numeroDocCifrado String
  numeroDocHash    String
  numeroDocFinal   String

  banco         String?
  tipoCuenta    String?
  /// Cifrada: junto con el documento identifica a una persona (Ley 1581).
  cuentaCifrada String?
  cuentaFinal   String?

  activo Boolean @default(true)

  empresa  EmpresaAdministrada      @relation(fields: [empresaId], references: [id])
  reglas   ReglaDispersionDestino[]
  destinos DispersionDestino[]
  egresos  Egreso[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([empresaId, numeroDocHash])
  @@index([empresaId, activo])
}

/// Regla reutilizable: «esta operación se reparte 60/30/10 entre estos tres».
model ReglaDispersion {
  id        String @id @default(cuid())
  empresaId String

  nombre      String
  tipoReparto TipoReparto
  activa      Boolean     @default(true)

  empresa      EmpresaAdministrada      @relation(fields: [empresaId], references: [id])
  destinos     ReglaDispersionDestino[]
  dispersiones Dispersion[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([empresaId, nombre])
}

model ReglaDispersionDestino {
  id             String @id @default(cuid())
  /// Denormalizado a propósito: sin él la extensión de Prisma no puede filtrar esta
  /// tabla y quedaría fuera de la RLS. Toda entidad de negocio cuelga de la empresa.
  empresaId      String
  reglaId        String
  destinatarioId String

  /// Uno de los dos según el tipoReparto de la regla; el otro va nulo.
  porcentaje Decimal? @db.Decimal(7, 4)
  montoFijo  Decimal? @db.Decimal(18, 2)

  /// Orden de aplicación. También define quién absorbe el residuo del redondeo.
  orden Int

  empresa      EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  regla        ReglaDispersion     @relation(fields: [reglaId], references: [id])
  destinatario Destinatario        @relation(fields: [destinatarioId], references: [id])

  @@unique([reglaId, destinatarioId])
  @@index([reglaId, orden])
}

model Dispersion {
  id          String @id @default(cuid())
  empresaId   String
  operacionId String @unique

  montoTotal Decimal          @db.Decimal(18, 2)
  moneda     Moneda           @default(COP)
  estado     EstadoDispersion @default(PENDIENTE)

  /// Qué regla se usó. Null cuando el reparto se armó a mano.
  reglaId String?

  empresa   EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  operacion Operacion           @relation(fields: [operacionId], references: [id])
  regla     ReglaDispersion?    @relation(fields: [reglaId], references: [id])
  destinos  DispersionDestino[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([empresaId, estado])
}

model DispersionDestino {
  id             String  @id @default(cuid())
  empresaId      String
  dispersionId   String
  destinatarioId String?

  /// Copia del nombre y la cuenta al momento de dispersar. Si mañana alguien
  /// corrige la cuenta en el catálogo, el histórico tiene que seguir diciendo a
  /// dónde se giró realmente.
  ///
  /// cuentaSnapshot guarda la cuenta cifrada, igual que en el catálogo: es la
  /// prueba de a dónde salió la plata, y por eso se conserva completa. La API solo
  /// devuelve sus últimos cuatro dígitos.
  nombreSnapshot String
  cuentaSnapshot String?

  monto      Decimal  @db.Decimal(18, 2)
  porcentaje Decimal? @db.Decimal(7, 4)

  estado         EstadoDestino @default(PENDIENTE)
  ejecutadoEn    DateTime?
  referenciaPago String?
  observaciones  String?

  empresa      EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  dispersion   Dispersion          @relation(fields: [dispersionId], references: [id])
  destinatario Destinatario?       @relation(fields: [destinatarioId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([empresaId, estado])
  @@index([dispersionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Etapa 3 — Egresos
//
// Estrena el patrón que después reusan la nómina (etapa 5) y la facturación
// (etapa 6): un registro operativo que emite un documento legal con consecutivo.
// ─────────────────────────────────────────────────────────────────────────────

/// Pago por un intangible: licencia, servicio digital, derechos.
/// Es un registro operativo — el documento legal es su `OrdenPago`.
model Egreso {
  id        String @id @default(cuid())
  empresaId String

  concepto       String
  tipoIntangible TipoIntangible
  descripcion    String?

  // ── A quién se le pagó ────────────────────────────────────────────────────
  /// Copia del nombre al momento del egreso. Si mañana corrigen el catálogo, la
  /// orden ya emitida tiene que seguir diciendo a quién se le pagó realmente.
  beneficiario   String
  /// Enlace opcional al catálogo de la etapa 2, cuando el beneficiario ya está.
  /// Opcional a propósito: obligar a llenar un catálogo antes de registrar el
  /// primer egreso frena justo lo que el módulo viene a agilizar.
  destinatarioId String?

  // ── La plata ──────────────────────────────────────────────────────────────
  // Regla 2 del brief: monto, moneda y —si aplica— la tasa y el equivalente en
  // pesos, congelados al momento del egreso. Nunca recalcular con la de hoy.
  monto      Decimal  @db.Decimal(18, 2)
  moneda     Moneda
  tasaCambio Decimal? @db.Decimal(18, 6)
  /// Calculado y persistido al guardar, nunca derivado en cada lectura.
  montoCOP   Decimal  @db.Decimal(18, 2)

  fecha  DateTime
  estado EstadoEgreso @default(REGISTRADO)

  motivoAnulacion String?
  anuladoEn       DateTime?
  anuladoPorId    String?

  empresa      EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  destinatario Destinatario?       @relation(fields: [destinatarioId], references: [id])
  anuladoPor   Usuario?            @relation("egresoAnuladoPor", fields: [anuladoPorId], references: [id])
  ordenes      OrdenPago[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([empresaId, fecha(sort: Desc)])
  @@index([empresaId, estado])
  @@index([destinatarioId])
}

/// La orden de pago: el documento legal. No se edita ni se borra.
///
/// **No lleva `deletedAt`**, y es la única tabla del sistema sin él (excepción a la
/// regla 4 del brief). Si un documento con consecutivo pudiera desaparecer de las
/// consultas, la serie quedaría con huecos que nadie sabe explicar.
model OrdenPago {
  id        String @id @default(cuid())
  empresaId String
  egresoId  String

  /// Lo que se imprime: «OP-000042». Único por empresa, para siempre.
  consecutivo String
  /// El número suelto, para ordenar sin parsear el texto.
  numero      Int

  estado EstadoOrdenPago @default(VIGENTE)

  /// **Lo que decía el documento el día que se emitió.**
  ///
  /// Congela el emisor —nombre, NIT, dirección, municipio—, el beneficiario, el
  /// concepto y los montos. El PDF se regenera desde aquí, así que cambiar hoy la
  /// dirección de la empresa no altera una orden emitida el año pasado.
  ///
  /// Lo inmutable es el contenido, no los bytes (docs/ETAPA-03.md §1.1).
  contenido Json

  /// sha256 del PDF emitido. Deja constancia del archivo exacto.
  hashArchivo  String?
  /// Clave en el bucket. Nula hasta la etapa 6, que es cuando se monta R2.
  claveArchivo String?

  emitidaEn    DateTime @default(now())
  emitidaPorId String

  motivoAnulacion String?
  anuladaEn       DateTime?
  anuladaPorId    String?

  /// Si esta orden reemplaza a una anulada, cuál. Encadena el historial.
  /// Es `@unique` para que una anulada se reemita **una sola vez**: sin eso, dos
  /// reemisiones dejarían dos documentos vigentes por un mismo egreso.
  reemplazaAId String? @unique

  empresa        EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  egreso         Egreso              @relation(fields: [egresoId], references: [id])
  emitidaPor     Usuario             @relation("ordenEmitidaPor", fields: [emitidaPorId], references: [id])
  anuladaPor     Usuario?            @relation("ordenAnuladaPor", fields: [anuladaPorId], references: [id])
  reemplazaA     OrdenPago?          @relation("reemision", fields: [reemplazaAId], references: [id])
  reemplazadaPor OrdenPago?          @relation("reemision")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, consecutivo])
  @@index([empresaId, estado])
  @@index([empresaId, numero(sort: Desc)])
  @@index([egresoId])
}

enum TipoIntangible {
  // TODO [CONFIRMAR] Lista de arranque: el brief solo da ejemplos, no una
  // taxonomía. Si con el tiempo la mitad cae en OTRO, la lista real del cliente
  // se lee sola en los datos.
  LICENCIA_SOFTWARE
  SERVICIO_DIGITAL
  DERECHOS
  SUSCRIPCION
  OTRO
}

enum EstadoEgreso {
  REGISTRADO // vigente, con su orden de pago emitida
  ANULADO // sin efecto, se conserva con su motivo
}

enum EstadoOrdenPago {
  VIGENTE
  ANULADA
}

// ─────────────────────────────────────────────────────────────────────────────
// Etapa 5 — Empleados y nómina documental
//
// Segunda aparición del patrón «registro operativo → documento con consecutivo».
// La diferencia con Egresos: aquí conviven documentos que se congelan (el recibo)
// con documentos que se generan al vuelo (la carta laboral). Ver docs/ETAPA-05.md §3.
// ─────────────────────────────────────────────────────────────────────────────

model Empleado {
  id        String @id @default(cuid())
  empresaId String

  nombre  String
  tipoDoc TipoDocumento

  /// Cifrado, igual que en Cliente y Destinatario: es un dato personal (Ley 1581).
  numeroDocCifrado String
  numeroDocHash    String
  numeroDocFinal   String

  cargo        String
  salarioBase  Decimal   @db.Decimal(18, 2)
  moneda       Moneda    @default(COP)
  fechaIngreso DateTime
  fechaRetiro  DateTime?

  tipoContrato TipoContrato @default(INDEFINIDO)

  // Los imprime la carta laboral y el certificado de ingresos.
  email     String?
  telefono  String?
  direccion String?

  /// Activo o retirado. Distinto de `deletedAt`, por la misma razón que en Cliente:
  /// un empleado retirado no aparece al liquidar, pero sus recibos siguen ahí.
  activo Boolean @default(true)

  empresa    EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  recibos    ReciboNomina[]
  documentos DocumentoLaboral[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([empresaId, numeroDocHash])
  @@index([empresaId, activo])
  @@index([empresaId, nombre])
}

/// El recibo de nómina: documento legal con consecutivo.
///
/// **Sin `deletedAt`**, igual que OrdenPago: un documento con consecutivo no puede
/// desaparecer de las consultas sin dejar un hueco en la serie.
model ReciboNomina {
  id         String @id @default(cuid())
  empresaId  String
  empleadoId String

  /// Lo que se imprime: «RN-000042». Único por empresa, para siempre.
  consecutivo String
  numero      Int

  tipoPeriodo   TipoPeriodo
  periodoInicio DateTime
  periodoFin    DateTime

  /// Totalizados al liquidar y persistidos, nunca derivados en cada lectura.
  totalDevengado Decimal @db.Decimal(18, 2)
  totalDeducido  Decimal @db.Decimal(18, 2)
  neto           Decimal @db.Decimal(18, 2)
  moneda         Moneda  @default(COP)

  estado EstadoDocumento @default(VIGENTE)

  /// Lo que decía el documento al emitirse: el emisor, el empleado, su cargo y sus
  /// conceptos. Cambiar mañana el cargo no altera un recibo de marzo.
  contenido   Json
  hashArchivo String?

  emitidoEn    DateTime @default(now())
  emitidoPorId String

  motivoAnulacion String?
  anuladoEn       DateTime?
  anuladoPorId    String?

  /// Si reemplaza a uno anulado, cuál. Único: se reemite una sola vez.
  reemplazaAId String? @unique

  empresa        EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  empleado       Empleado            @relation(fields: [empleadoId], references: [id])
  emitidoPor     Usuario             @relation("reciboEmitidoPor", fields: [emitidoPorId], references: [id])
  anuladoPor     Usuario?            @relation("reciboAnuladoPor", fields: [anuladoPorId], references: [id])
  reemplazaA     ReciboNomina?       @relation("reemisionRecibo", fields: [reemplazaAId], references: [id])
  reemplazadoPor ReciboNomina?       @relation("reemisionRecibo")
  conceptos      ConceptoNomina[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, consecutivo])
  @@index([empresaId, estado])
  @@index([empresaId, numero(sort: Desc)])
  /// Un empleado no puede tener dos recibos **vigentes** del mismo período. El
  /// índice no lo puede expresar solo —los anulados sí se repiten—, así que la
  /// regla vive en el servicio y esto es lo que la hace rápida de comprobar.
  @@index([empleadoId, periodoInicio])
}

/// Una línea del recibo. El concepto es texto libre a propósito: la clienta liquida
/// escribiendo los valores, no eligiendo de un catálogo cerrado (docs/ETAPA-05.md §1).
model ConceptoNomina {
  id        String @id @default(cuid())
  empresaId String
  reciboId  String

  tipo     TipoConcepto
  concepto String
  valor    Decimal      @db.Decimal(18, 2)
  orden    Int

  empresa EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  recibo  ReciboNomina        @relation(fields: [reciboId], references: [id])

  @@index([reciboId, orden])
  /// Para responder «cuánto se pagó de auxilio de transporte en el año» sin abrir
  /// cada recibo. Esa pregunta llega en Contabilidad.
  @@index([empresaId, concepto])
}

/// Carta laboral o certificado de ingresos.
///
/// Se generan **al vuelo**, no se congelan: certifican un estado actual, no un hecho
/// del pasado. Si piden la carta otra vez en junio, la respuesta correcta es la de
/// junio. Aquí solo queda constancia de que se emitió (docs/ETAPA-05.md §3).
model DocumentoLaboral {
  id         String @id @default(cuid())
  empresaId  String
  empleadoId String

  tipo TipoDocumentoLaboral
  /// Solo para el certificado: de qué año son los ingresos que resume.
  anio Int?

  emitidoEn    DateTime @default(now())
  emitidoPorId String

  empresa    EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  empleado   Empleado            @relation(fields: [empleadoId], references: [id])
  emitidoPor Usuario             @relation("documentoEmitidoPor", fields: [emitidoPorId], references: [id])

  @@index([empleadoId, emitidoEn(sort: Desc)])
  @@index([empresaId, tipo])
}

enum TipoContrato {
  INDEFINIDO
  FIJO
  OBRA_LABOR
  PRESTACION_SERVICIOS
  APRENDIZAJE
}

enum TipoPeriodo {
  QUINCENAL
  MENSUAL
}

enum TipoConcepto {
  DEVENGADO
  DEDUCCION
}

enum TipoDocumentoLaboral {
  CARTA_LABORAL
  CERTIFICADO_INGRESOS
}

/// Estado de un documento legal. Va aparte de `EstadoOrdenPago` porque el género
/// cambia —una orden queda «anulada», un recibo «anulado»— y esa etiqueta se
/// imprime. Compartir el enum obligaría a redactar los mensajes en neutro.
enum EstadoDocumento {
  VIGENTE
  ANULADO
}

// ─────────────────────────────────────────────────────────────────────────────
// Etapa 6a — Gastos, calendario tributario y solicitudes de documento
//
// La facturación electrónica (6b) queda aplazada a la espera de las credenciales
// de Siigo. Nada de lo de aquí depende de ella.
// ─────────────────────────────────────────────────────────────────────────────

/// Gasto operativo, con su soporte adjunto.
model Gasto {
  id        String @id @default(cuid())
  empresaId String

  categoria CategoriaGasto
  concepto  String
  proveedor String?

  // Regla 2 del brief: monto, moneda y —si aplica— tasa y equivalente en pesos,
  // congelados al momento del gasto.
  monto      Decimal  @db.Decimal(18, 2)
  moneda     Moneda   @default(COP)
  tasaCambio Decimal? @db.Decimal(18, 6)
  montoCOP   Decimal  @db.Decimal(18, 2)

  fecha     DateTime
  /// Si cuenta para la declaración de renta. Lo decide quien registra.
  deducible Boolean  @default(true)

  /// Clave del soporte en el almacén. **Nunca** se entrega al navegador: el archivo
  /// se sirve por el backend, que verifica permiso y empresa en cada descarga.
  soporteClave  String?
  /// El nombre que traía el archivo. Es para mostrar, nunca para enrutar.
  soporteNombre String?
  soporteTipo   String?

  empresa EmpresaAdministrada @relation(fields: [empresaId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([empresaId, fecha(sort: Desc)])
  @@index([empresaId, categoria])
}

/// Las fechas del calendario tributario de un año.
///
/// **No dice a quién le toca.** Quién queda cubierto por una fila se resuelve al
/// consultar, cruzando con el último dígito del NIT, el tipo de contribuyente y
/// —solo en ICA— el municipio del cliente. Guardar la asignación sería duplicar:
/// el día que un cliente cambie de tipo, esa tabla quedaría mintiendo.
///
/// **Sin `empresaId`, y es la única tabla de negocio así.** Las fechas de la DIAN
/// son las mismas para todo el mundo, así que tampoco lleva RLS. La prueba de
/// catálogo lo comprueba explícitamente para que no parezca un olvido.
model CalendarioTributario {
  id   String @id @default(cuid())
  anio Int

  tipoObligacion      TipoObligacion
  /// 0 a 9. Algunas obligaciones agrupan dos dígitos: van dos filas.
  ultimoDigito        Int
  /// Nulo cuando la fecha aplica a cualquier tipo de contribuyente.
  tipoContribuyente   TipoContribuyente?
  /// Solo para ICA, que es municipal. El código DANE lo identifica sin ambigüedad.
  codigoDaneMunicipio String?

  fechaLimite DateTime
  descripcion String?

  /// Qué importación creó esta fila. Permite reemplazar un año sin borrar el
  /// anterior: se marca la importación vieja como no vigente y se puede volver.
  importacionId String
  importacion   ImportacionCalendario @relation(fields: [importacionId], references: [id])

  createdAt DateTime @default(now())

  @@index([anio, tipoObligacion, ultimoDigito])
  @@index([importacionId])
}

/// Una carga del calendario. Versiona el año en vez de sobrescribirlo.
model ImportacionCalendario {
  id   String @id @default(cuid())
  anio Int

  /// Solo una importación vigente por año. Las anteriores quedan para volver atrás.
  vigente Boolean @default(true)
  filas   Int
  nota    String?

  importadoEn    DateTime @default(now())
  importadoPorId String
  importadoPor   Usuario  @relation("calendarioImportadoPor", fields: [importadoPorId], references: [id])

  fechas CalendarioTributario[]

  @@index([anio, vigente])
}

/// Documento que se le pide a un cliente, con su plazo.
model SolicitudDocumento {
  id        String @id @default(cuid())
  empresaId String
  clienteId String

  documento   String
  descripcion String?
  estado      EstadoSolicitud @default(SOLICITADO)
  fechaLimite DateTime

  /// El archivo que el cliente entregó, cuando llega.
  archivoClave  String?
  archivoNombre String?
  archivoTipo   String?
  recibidoEn    DateTime?

  empresa EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  cliente Cliente             @relation(fields: [clienteId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([empresaId, estado])
  @@index([empresaId, fechaLimite])
  @@index([clienteId])
}

enum CategoriaGasto {
  // TODO [CONFIRMAR] Lista de arranque. Si con el tiempo la mitad cae en OTRO, la
  // taxonomía real del cliente se lee sola en los datos.
  ARRIENDO
  SERVICIOS_PUBLICOS
  NOMINA_ADMINISTRATIVA
  HONORARIOS
  TRANSPORTE
  PAPELERIA
  TECNOLOGIA
  IMPUESTOS
  OTRO
}

enum TipoObligacion {
  RENTA
  RETENCIONES
  ICA // municipal, no DIAN
  EXOGENA
}

enum EstadoSolicitud {
  SOLICITADO
  RECIBIDO
  VENCIDO
}
