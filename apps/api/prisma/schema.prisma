// Esquema núcleo — Etapa 1.
// Diseño aprobado en docs/ETAPA-01.md §1. Los cambios de esquema a mitad de camino
// son el mayor costo de este proyecto: cualquier modificación se propone primero.
//
// Toda tabla que se agregue con `empresaId` debe traer su política de Row Level
// Security en la misma migración (docs/SEGURIDAD.md §1).

generator client {
  provider = "prisma-client-js"
}

// Desde Prisma 7 las URLs de conexión no van en el esquema:
//   - las migraciones toman DIRECT_URL (rol nexo_owner) desde prisma.config.ts
//   - el runtime toma DATABASE_URL (rol nexo_app) desde el driver adapter en
//     PrismaService, que es lo que hace que la RLS aplique de verdad
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum ModuloSistema {
  OPERACIONES
  EGRESOS
  EMPLEADOS
  CONTABILIDAD
  CUMPLIMIENTO
  CLIENTES
  ADMINISTRACION
}

enum NombreRol {
  ADMINISTRADOR
  EQUIPO_INTERNO
}

enum TipoContribuyente {
  GRAN_CONTRIBUYENTE
  PERSONA_JURIDICA
  PERSONA_NATURAL
  REGIMEN_SIMPLE
  NO_RESPONSABLE_IVA
}

enum TipoDocumento {
  CC
  CE
  NIT
  PASAPORTE
  PPT
}

enum Moneda {
  COP
  USD
  USDT
}

enum TipoConsecutivo {
  ORDEN_PAGO
  FACTURA
  RECIBO_NOMINA
}

enum AccionAudit {
  CREAR
  ACTUALIZAR
  ANULAR
  ELIMINAR // soft delete: nada se borra físicamente
  INGRESAR
  SALIR
  INGRESO_FALLIDO
  EXPORTAR // exportación masiva de datos personales — Ley 1581
  CAMBIAR_EMPRESA
  LLAMADA_EXTERNA
}

// ─────────────────────────────────────────────────────────────
// Empresa administrada — raíz de todo el aislamiento
// ─────────────────────────────────────────────────────────────

model EmpresaAdministrada {
  id                  String            @id @default(cuid())
  nombre              String
  nombreComercial     String?
  nit                 String            @unique
  digitoVerificacion  Int
  tipoContribuyente   TipoContribuyente
  municipio           String // sede principal — define el ICA
  codigoDaneMunicipio String?
  direccion           String?
  telefono            String?
  email               String?
  logoUrl             String? // identidad de la empresa en los PDF generados
  esNexo              Boolean           @default(false) // índice único parcial: solo una
  activa              Boolean           @default(true)

  usuarios     UsuarioEmpresa[]
  consecutivos Consecutivo[]
  auditLogs    AuditLog[]

  clientes           Cliente[]
  operaciones        Operacion[]
  destinatarios      Destinatario[]
  reglasDispersion   ReglaDispersion[]
  reglasDestino      ReglaDispersionDestino[]
  dispersiones       Dispersion[]
  dispersionDestinos DispersionDestino[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([activa, deletedAt])
}

// ─────────────────────────────────────────────────────────────
// Identidad y acceso
// ─────────────────────────────────────────────────────────────

model Rol {
  id          String    @id @default(cuid())
  nombre      NombreRol @unique
  descripcion String?
  usuarios    Usuario[]
}

model Usuario {
  id           String @id @default(cuid())
  nombre       String
  email        String @unique
  passwordHash String // argon2id

  totpSecretCifrado String? // AES-256-GCM; null hasta que registre el 2FA
  totpActivado      Boolean @default(false)

  // Un código TOTP sirve una sola vez: dentro de su ventana de validez no se
  // vuelve a aceptar. Sin esto, un código interceptado se puede reusar durante
  // los segundos que le queden de vida (docs/SEGURIDAD.md §4).
  ultimoTotpUsado String?
  ultimoTotpEn    DateTime?

  rolId  String
  rol    Rol     @relation(fields: [rolId], references: [id])
  activo Boolean @default(true)

  debeCambiarPassword Boolean   @default(true)
  ultimoAcceso        DateTime?
  intentosFallidos    Int       @default(0)
  bloqueadoHasta      DateTime?

  empresas            UsuarioEmpresa[]
  permisos            PermisoModulo[]
  operacionesAnuladas Operacion[]      @relation("operacionAnuladaPor")
  sesiones            SesionRefresh[]
  codigosRespaldo     CodigoRespaldo[]
  auditLogs           AuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email, deletedAt])
}

/// Qué empresas puede ver un usuario. El rol ADMINISTRADOR accede a todas sin
/// necesidad de filas aquí; se resuelve en EmpresaGuard.
model UsuarioEmpresa {
  id        String @id @default(cuid())
  usuarioId String
  empresaId String

  usuario Usuario             @relation(fields: [usuarioId], references: [id])
  empresa EmpresaAdministrada @relation(fields: [empresaId], references: [id])

  createdAt DateTime @default(now())

  @@unique([usuarioId, empresaId])
  @@index([empresaId])
}

/// Permiso por módulo, global al usuario y no por empresa (decisión confirmada,
/// docs/ARQUITECTURA.md §5.2). Se verifica SIEMPRE en el backend.
model PermisoModulo {
  id          String        @id @default(cuid())
  usuarioId   String
  modulo      ModuloSistema
  puedeVer    Boolean       @default(false)
  puedeEditar Boolean       @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, modulo])
}

/// Refresh tokens con rotación. Reusar un token ya consumido revoca toda la familia.
model SesionRefresh {
  id        String @id @default(cuid())
  usuarioId String
  tokenHash String @unique // SHA-256 del token; el token en claro no se guarda
  familiaId String

  expiraEn   DateTime
  revocadaEn DateTime?
  ip         String?
  userAgent  String?

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())

  @@index([usuarioId, revocadaEn])
  @@index([familiaId])
}

/// Códigos de un solo uso para recuperar el acceso si se pierde el TOTP.
model CodigoRespaldo {
  id         String    @id @default(cuid())
  usuarioId  String
  codigoHash String
  usadoEn    DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())

  @@index([usuarioId, usadoEn])
}

// ─────────────────────────────────────────────────────────────
// Consecutivos de documentos legales
// ─────────────────────────────────────────────────────────────

/// Se incrementa con bloqueo de fila dentro de la misma transacción que crea el
/// documento. Nunca se calcula con count(). Un consecutivo emitido no se reutiliza
/// aunque el documento se anule.
model Consecutivo {
  id          String          @id @default(cuid())
  empresaId   String
  tipo        TipoConsecutivo
  prefijo     String          @default("")
  ultimoValor Int             @default(0)

  empresa EmpresaAdministrada @relation(fields: [empresaId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([empresaId, tipo])
}

// ─────────────────────────────────────────────────────────────
// Audit log — append-only, garantizado por trigger y permisos
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id        BigInt      @id @default(autoincrement())
  usuarioId String?
  empresaId String? // null en eventos previos a elegir empresa (ingreso, fallo)
  accion    AccionAudit
  entidad   String
  entidadId String?

  valorAnterior Json?
  valorNuevo    Json?

  ip        String?
  userAgent String?
  ruta      String?
  createdAt DateTime @default(now())

  usuario Usuario?             @relation(fields: [usuarioId], references: [id])
  empresa EmpresaAdministrada? @relation(fields: [empresaId], references: [id])

  @@index([empresaId, createdAt])
  @@index([usuarioId, createdAt])
  @@index([entidad, entidadId])
  @@index([createdAt])
}

// ═════════════════════════════════════════════════════════════
// Etapa 2 — Operaciones y dispersión
// ═════════════════════════════════════════════════════════════

enum TipoCliente {
  PERSONA_NATURAL
  PERSONA_JURIDICA
}

enum EstadoOperacion {
  BORRADOR // se está capturando; no cuenta para reportes
  REGISTRADA // completa y vigente; editable
  CONCILIADA // su dispersión quedó ejecutada por completo; ya no se edita
  ANULADA // sin efecto, se conserva con su motivo
}

enum RedBlockchain {
  BITCOIN
  ETHEREUM
  TRON
  BSC
  POLYGON
  SOLANA
  OTRA
}

enum TipoReparto {
  PORCENTAJE
  MONTO_FIJO
}

enum EstadoDispersion {
  PENDIENTE
  PARCIAL
  EJECUTADA
}

enum EstadoDestino {
  PENDIENTE
  EJECUTADO
  DEVUELTO
}

/// Adelanto mínimo de la Etapa 4: `Operacion` cuelga de un cliente. La Etapa 4 le
/// agrega portafolio, contacto y calendario tributario.
model Cliente {
  id        String @id @default(cuid())
  empresaId String

  nombre  String
  tipo    TipoCliente
  tipoDoc TipoDocumento

  /// Cifrado con AES-256-GCM: es un dato personal (Ley 1581, docs/SEGURIDAD.md §5).
  numeroDocCifrado String
  /// HMAC determinista. Es lo único indexable: permite buscar por documento sin
  /// descifrar y sin exponer el número en claro dentro de un índice.
  numeroDocHash    String
  /// Últimos cuatro dígitos, para mostrar «•••• 4821» sin descifrar en cada fila.
  numeroDocFinal   String

  /// Define las fechas del calendario tributario (Etapa 6).
  ultimoDigitoNit Int?
  municipio       String?
  email           String?
  telefono        String?

  empresa     EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  operaciones Operacion[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([empresaId, numeroDocHash])
  @@index([empresaId, nombre])
}

model Operacion {
  id        String @id @default(cuid())
  empresaId String
  clienteId String

  /// Hash de la transacción en la cadena. Es el buscador central del sistema.
  hash String?
  red  RedBlockchain?

  // ── El activo que se movió ────────────────────────────────────────────────
  // TODO [CONFIRMAR] Opcionales hasta que el cliente confirme si registra la
  // cantidad de cripto o solo los valores en pesos. Nulos, la ganancia es la
  // resta directa entre venta y compra.
  cantidad     Decimal? @db.Decimal(36, 18)
  monedaActivo Moneda?

  // ── La plata que entró y salió ────────────────────────────────────────────
  // Dos tasas y no una: la de compra y la de venta son distintas, y en esa
  // diferencia está el negocio. Quedan congeladas al momento de la operación —
  // recalcular con la tasa de hoy cambiaría el resultado de un cierre pasado.
  valorCompra  Decimal  @db.Decimal(18, 2)
  monedaCompra Moneda
  tasaCompra   Decimal? @db.Decimal(18, 6)

  valorVenta  Decimal  @db.Decimal(18, 2)
  monedaVenta Moneda
  tasaVenta   Decimal? @db.Decimal(18, 6)

  /// Calculada y persistida al guardar, nunca derivada en cada lectura (brief §5).
  gananciaCOP Decimal @db.Decimal(18, 2)

  estado         EstadoOperacion @default(REGISTRADA)
  fechaOperacion DateTime
  observaciones  String?

  motivoAnulacion String?
  anuladaEn       DateTime?
  anuladaPorId    String?

  empresa    EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  cliente    Cliente             @relation(fields: [clienteId], references: [id])
  anuladaPor Usuario?            @relation("operacionAnuladaPor", fields: [anuladaPorId], references: [id])
  dispersion Dispersion?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// El buscador por hash es la función más usada del sistema: este índice es lo
  /// que hace que responda al instante en vez de recorrer la tabla.
  @@unique([empresaId, hash])
  @@index([empresaId, fechaOperacion(sort: Desc)])
  @@index([empresaId, estado])
  @@index([clienteId])
}

/// Catálogo de a quién se le dispersa. Existe para no volver a escribir la cuenta
/// bancaria en cada operación, que es donde se cometen los errores caros.
model Destinatario {
  id        String @id @default(cuid())
  empresaId String

  nombre  String
  tipoDoc TipoDocumento

  numeroDocCifrado String
  numeroDocHash    String
  numeroDocFinal   String

  banco         String?
  tipoCuenta    String?
  /// Cifrada: junto con el documento identifica a una persona (Ley 1581).
  cuentaCifrada String?
  cuentaFinal   String?

  activo Boolean @default(true)

  empresa  EmpresaAdministrada      @relation(fields: [empresaId], references: [id])
  reglas   ReglaDispersionDestino[]
  destinos DispersionDestino[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([empresaId, numeroDocHash])
  @@index([empresaId, activo])
}

/// Regla reutilizable: «esta operación se reparte 60/30/10 entre estos tres».
model ReglaDispersion {
  id        String @id @default(cuid())
  empresaId String

  nombre      String
  tipoReparto TipoReparto
  activa      Boolean     @default(true)

  empresa      EmpresaAdministrada      @relation(fields: [empresaId], references: [id])
  destinos     ReglaDispersionDestino[]
  dispersiones Dispersion[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([empresaId, nombre])
}

model ReglaDispersionDestino {
  id             String @id @default(cuid())
  /// Denormalizado a propósito: sin él la extensión de Prisma no puede filtrar esta
  /// tabla y quedaría fuera de la RLS. Toda entidad de negocio cuelga de la empresa.
  empresaId      String
  reglaId        String
  destinatarioId String

  /// Uno de los dos según el tipoReparto de la regla; el otro va nulo.
  porcentaje Decimal? @db.Decimal(7, 4)
  montoFijo  Decimal? @db.Decimal(18, 2)

  /// Orden de aplicación. También define quién absorbe el residuo del redondeo.
  orden Int

  empresa      EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  regla        ReglaDispersion     @relation(fields: [reglaId], references: [id])
  destinatario Destinatario        @relation(fields: [destinatarioId], references: [id])

  @@unique([reglaId, destinatarioId])
  @@index([reglaId, orden])
}

model Dispersion {
  id          String @id @default(cuid())
  empresaId   String
  operacionId String @unique

  montoTotal Decimal          @db.Decimal(18, 2)
  moneda     Moneda           @default(COP)
  estado     EstadoDispersion @default(PENDIENTE)

  /// Qué regla se usó. Null cuando el reparto se armó a mano.
  reglaId String?

  empresa   EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  operacion Operacion           @relation(fields: [operacionId], references: [id])
  regla     ReglaDispersion?    @relation(fields: [reglaId], references: [id])
  destinos  DispersionDestino[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([empresaId, estado])
}

model DispersionDestino {
  id             String  @id @default(cuid())
  empresaId      String
  dispersionId   String
  destinatarioId String?

  /// Copia del nombre y la cuenta al momento de dispersar. Si mañana alguien
  /// corrige la cuenta en el catálogo, el histórico tiene que seguir diciendo a
  /// dónde se giró realmente.
  nombreSnapshot String
  cuentaSnapshot String?

  monto      Decimal  @db.Decimal(18, 2)
  porcentaje Decimal? @db.Decimal(7, 4)

  estado         EstadoDestino @default(PENDIENTE)
  ejecutadoEn    DateTime?
  referenciaPago String?
  observaciones  String?

  empresa      EmpresaAdministrada @relation(fields: [empresaId], references: [id])
  dispersion   Dispersion          @relation(fields: [dispersionId], references: [id])
  destinatario Destinatario?       @relation(fields: [destinatarioId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([empresaId, estado])
  @@index([dispersionId])
}
