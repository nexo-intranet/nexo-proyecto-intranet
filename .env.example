# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno. Copiar a .env y llenar con valores reales.
#
# EL ARCHIVO .env NUNCA SE VERSIONA. Si un secreto real entra al historial de git,
# se rota primero y se limpia después — rotar no es opcional. Ver docs/SEGURIDAD.md §2.
#
# Generar secretos:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
TZ=America/Bogota

# ── Base de datos ────────────────────────────────────────────────────────────
# DATABASE_URL usa el rol de aplicación: sin ser dueño de las tablas y sin BYPASSRLS.
# Es lo que hace que la Row Level Security realmente aplique en runtime.
# DIRECT_URL usa el rol dueño y solo lo usa Prisma Migrate.
DATABASE_URL="postgresql://nexo_app:nexo_local_app@localhost:5432/nexo?schema=public"
DIRECT_URL="postgresql://nexo_owner:nexo_local@localhost:5432/nexo?schema=public"

# ── Sesión ───────────────────────────────────────────────────────────────────
# Dos secretos distintos, cada uno de 32 bytes aleatorios.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost

# ── Cifrado en reposo (AES-256-GCM) ──────────────────────────────────────────
# 32 bytes en base64. Se guarda la versión junto al ciphertext para poder rotar.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
# HMAC determinista para poder buscar documentos de identidad sin descifrarlos.
HMAC_DOC_KEY=

# ── Aplicación ───────────────────────────────────────────────────────────────
API_PORT=3001
# Origen exacto del frontend. Nunca "*". Varios orígenes separados por coma.
CORS_ORIGIN=http://localhost:3000

# ── Almacenamiento de archivos (Cloudflare R2, bucket PRIVADO) ───────────────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_URL_TTL_SEGUNDOS=300

# ── Frontend ─────────────────────────────────────────────────────────────────
# Todo lo que empiece por NEXT_PUBLIC_ termina en el bundle del navegador.
# Esta es la única permitida. Agregar otra exige justificación en el PR.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Solo servidor: el navegador nunca ve esta URL, habla con el proxy de Next.
API_INTERNAL_URL=http://localhost:3001

# ── Integraciones (etapa 6) ──────────────────────────────────────────────────
# Las credenciales de Siigo NO van aquí: son por empresa y se guardan cifradas
# en ConfigFacturacion. Aquí solo lo que es global a la integración.
SIIGO_BASE_URL=https://api.siigo.com/v1
SIIGO_PARTNER_ID=
WEBHOOK_SIIGO_SECRET=
